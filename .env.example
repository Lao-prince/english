# Docker Compose only. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Generate a separate value with: openssl rand -hex 32
SESSION_SECRET=
# Obtain the dedicated bot token from BotFather.
TELEGRAM_BOT_TOKEN=
# Optional. Bot username without @, for Mini App invitation links.
TELEGRAM_BOT_USERNAME=
LESSON_REMINDERS_ENABLED=false

# Local development only. Compose constructs its own DATABASE_URL using db:5432.
# DATABASE_URL=postgresql://english_space:local_password@localhost:5432/english_space
