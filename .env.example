# Copy to .env for a local PostgreSQL instance before using Prisma.
DATABASE_URL=postgresql://english_space:local_password@localhost:5432/english_space

# Required together for Telegram authentication.
TELEGRAM_BOT_TOKEN=
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Docker Compose uses this password for its dedicated PostgreSQL database.
# Use a URL-safe hex value. Generate on the host with: openssl rand -hex 32
POSTGRES_PASSWORD=
# The Web port is bound to the host loopback interface.
WEB_PORT=8080
