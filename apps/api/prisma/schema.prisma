generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

model StudentInvitation {
  codeHash   String    @id
  expiresAt  DateTime  @db.Timestamptz(3)
  redeemedAt DateTime? @db.Timestamptz(3)
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  telegramId BigInt?  @unique
  role       Role
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  bookings   Booking[]
}

model AvailabilitySlot {
  id       String    @id @db.Uuid
  startsAt DateTime  @db.Timestamptz(3)
  endsAt   DateTime  @db.Timestamptz(3)
  timeZone String
  closedAt DateTime? @db.Timestamptz(3)
  bookings Booking[]

  @@index([startsAt])
}

model Booking {
  id        String           @id @default(uuid()) @db.Uuid
  slotId    String           @db.Uuid
  studentId String           @db.Uuid
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  cancelledAt DateTime?      @db.Timestamptz(3)
  chargeApplies Boolean      @default(false)
  slot      AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  student   User             @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([slotId, studentId, createdAt])
}
