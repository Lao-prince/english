generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

enum ReminderState {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
  UNKNOWN
}

enum CreditReason {
  GRANT
  COMPLETED_LESSON
  SAME_DAY_CANCELLATION
  DEBIT_REVERSAL
}

model StudentInvitation {
  codeHash   String    @id
  expiresAt  DateTime  @db.Timestamptz(3)
  redeemedAt DateTime? @db.Timestamptz(3)
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  telegramId BigInt?  @unique
  role       Role
  displayName String?  @db.VarChar(80)
  telegramName String? @db.VarChar(120)
  telegramUsername String? @db.VarChar(32)
  telegramAvatarUrl String?
  telegramProfileAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  bookings   Booking[]
  creditEntries CreditEntry[]
  lessonReminders LessonReminder[]
  bookingMoves BookingMove[]
}

model AvailabilitySlot {
  id       String    @id @db.Uuid
  startsAt DateTime  @db.Timestamptz(3)
  endsAt   DateTime  @db.Timestamptz(3)
  timeZone String
  closedAt DateTime? @db.Timestamptz(3)
  bookings Booking[]

  @@index([startsAt])
}

model Booking {
  id        String           @id @default(uuid()) @db.Uuid
  slotId    String           @db.Uuid
  originalSlotId String?    @db.Uuid
  studentId String           @db.Uuid
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  cancelledAt DateTime?      @db.Timestamptz(3)
  completedAt DateTime?      @db.Timestamptz(3)
  cancelledByTeacher Boolean @default(false)
  reopenedOnCancellation Boolean @default(false)
  cancellationReason String? @db.VarChar(200)
  chargeApplies Boolean      @default(false)
  slot      AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  student   User             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  creditEntry CreditEntry?
  reminders LessonReminder[]
  moves BookingMove[]

  @@index([studentId])
  @@index([slotId, studentId, createdAt])
}

model BookingMove {
  id                 String   @id @db.Uuid
  bookingId          String   @db.Uuid
  teacherId          String   @db.Uuid
  fromSlotId         String   @db.Uuid
  toSlotId           String   @db.Uuid
  fromStartsAt       DateTime @db.Timestamptz(3)
  fromEndsAt         DateTime @db.Timestamptz(3)
  toStartsAt         DateTime @db.Timestamptz(3)
  toEndsAt           DateTime @db.Timestamptz(3)
  reopenedPreviousSlot Boolean
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  teacher            User     @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}

model LessonReminder {
  bookingId     String        @db.Uuid
  recipientId   String        @db.Uuid
  state         ReminderState @default(PENDING)
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @db.Timestamptz(3)
  updatedAt     DateTime      @db.Timestamptz(3)
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recipient     User          @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([bookingId, recipientId])
  @@index([state, nextAttemptAt])
}

model CreditEntry {
  id        String       @id @default(uuid()) @db.Uuid
  studentId String       @db.Uuid
  bookingId String?      @unique @db.Uuid
  reversesId String?     @unique @db.Uuid
  packageId String?      @db.Uuid
  validThrough String?   @db.VarChar(10)
  packageTimeZone String? @db.VarChar(100)
  expiresAt DateTime?    @db.Timestamptz(3)
  amount    Int
  reason    CreditReason
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  student   User         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  booking   Booking?     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  reverses  CreditEntry? @relation("DebitReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal  CreditEntry? @relation("DebitReversal")
  creditPackage CreditEntry? @relation("PackageEntries", fields: [packageId], references: [id], onDelete: Restrict)
  packageEntries CreditEntry[] @relation("PackageEntries")

  @@index([studentId, createdAt])
  @@index([studentId, packageId])
}
